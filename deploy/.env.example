# Self-hosting only (docs/self-hosting.md): copy this file to deploy/.env and adjust PUBLIC_URL.
# On Railway the same settings are service variables (deploy/railway/provision.sh).

# Address you will use in the browser (the one shown by "tailscale serve status").
PUBLIC_URL=https://openlibrary.your-tailnet.ts.net

# tailscale serve acts as a proxy in front of the app.
TRUST_PROXY=true

# Days a web session lasts while unused (phones use tokens that never expire but can be revoked).
SESSION_TTL_DAYS=30

LOG_LEVEL=info

# Backups are run by the host here (systemd timer + restic, docs/self-hosting.md §5): keep the in-process ones off.
BACKUP_SCHEDULE=off

# Optional, free: a Google Books API key (Google Cloud console → Books API → Credentials → API key).
# Without it, Google Books often answers "quota exceeded" and only Open Library is used.
# GOOGLE_BOOKS_API_KEY=

# Passkeys from the Android app: SHA-256 fingerprint of the certificate that signs the APK (docs/deployment-runbook.md, Passkeys).
# ANDROID_CERT_SHA256=AA:BB:…
