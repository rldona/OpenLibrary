# Copia este archivo a deploy/.env y ajusta PUBLIC_URL.

# Dirección con la que entrarás desde el navegador (la que muestra «tailscale serve status»).
PUBLIC_URL=https://openlibrary.tu-tailnet.ts.net

# tailscale serve hace de proxy delante de la app.
TRUST_PROXY=true

# Días que dura una sesión web sin usarse (los móviles usan tokens que no caducan, revocables).
SESSION_TTL_DAYS=30

LOG_LEVEL=info
