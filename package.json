{
  "name": "openlibrary",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w @openlibrary/server",
    "dev:web": "npm run dev -w @openlibrary/web",
    "build": "npm run build -w @openlibrary/web && npm run build -w @openlibrary/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p apps/android/i18n",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "android:strings": "tsx apps/android/i18n/generate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "railway": "3.16.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
